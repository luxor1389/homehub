# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Only the PUBLIC anon key belongs here. Never put the service_role key in any VITE_ variable:
# everything prefixed with VITE_ is shipped to the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional: refetch interval (ms) used only while the Realtime connection is down. Default 30000.
# VITE_REALTIME_FALLBACK_POLL_MS=30000
